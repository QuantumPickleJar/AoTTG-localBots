<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AoTTG2.FlightRecorder</AssemblyName>
    <RootNamespace>Aicadets.FlightRecorder.UnityIl2Cpp</RootNamespace>
    <GameRoot Condition="'$(GameRoot)' == ''">$(AOTTG2_GAME_ROOT)</GameRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(GameRoot)\BepInEx\core\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(GameRoot)\BepInEx\core\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameRoot)\BepInEx\core\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameRoot)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(GameRoot)\BepInEx\interop\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Scripts">
      <HintPath>$(GameRoot)\BepInEx\interop\Scripts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Photon3Unity3D">
      <HintPath>$(GameRoot)\BepInEx\interop\Photon3Unity3D.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonUnityNetworking">
      <HintPath>$(GameRoot)\BepInEx\interop\PhotonUnityNetworking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PhotonRealtime">
      <HintPath>$(GameRoot)\BepInEx\interop\PhotonRealtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameRoot)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FlightRecorder.TransportClient">
      <HintPath>..\FlightRecorder.TransportClient\bin\$(Configuration)\net6.0\FlightRecorder.TransportClient.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="RequireInstalledInterop" BeforeTargets="ResolveReferences">
    <Error Condition="'$(GameRoot)' == ''" Text="Pass -p:GameRoot=&quot;C:\Path\To\AoTTG2&quot; or set AOTTG2_GAME_ROOT." />
    <Error Condition="!Exists('$(GameRoot)\BepInEx\interop\Scripts.dll')" Text="BepInEx-generated Scripts.dll is missing under GameRoot. Run the matching IL2CPP loader once before compiling." />
  </Target>
</Project>
